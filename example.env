# MetaFinder settings. Copy this file to `.env` (same folder) and edit it.
# `python -m metafinder` reads `.env` at startup. Variables already set in the environment win.
# Restart the server after changing anything here.

# Seconds an analysis may run before it is stopped. The worker paces itself to finish with
# partial results about 20 s before this limit.
METAFINDER_JOB_TIMEOUT=900

# Seconds an AI training run (the "Train AI" button) may run. It stops cleanly about 30 s before,
# and its progress can be downloaded and continued in another run. Default: METAFINDER_JOB_TIMEOUT.
# METAFINDER_TUNE_TIMEOUT=3600

# Threads an AI training run uses. Default 0 = CPU cores − 1.
# METAFINDER_TUNE_THREADS=0

# Largest game folder (MB) that is zipped for "Download game with best AI".
# METAFINDER_MAX_DOWNLOAD_MB=200

# How many analyses can run at the same time. Others wait in the queue.
METAFINDER_MAX_CONCURRENT=2

# 1 = also accept local folder paths (and show the bundled examples), 0 = GitHub URLs only.
# Set this to 0 if anyone else can reach the server: analysis runs the submitted code.
METAFINDER_ALLOW_LOCAL=1

# Password for the whole site (the browser asks for it; any user name works). Required when the
# server listens on anything but localhost, e.g. on Railway: set it there as a service variable.
# METAFINDER_PASSWORD=change-me

# Address and port to listen on. Railway sets PORT itself; the Docker image sets HOST=0.0.0.0.
# HOST=127.0.0.1
# PORT=8000

# Linux only, server running as root (the Docker image does this): run each analysis as this
# unprivileged user, so submitted code can't read the server's environment variables.
# METAFINDER_WORKER_USER=runner

# Memory cap per analysis, in MB (Node heap limit / Python address space on Linux).
# METAFINDER_WORKER_MEMORY_MB=1536

# Where job folders (params, worker logs, temporary clones) are kept. Default: .jobs in this folder.
# METAFINDER_JOBS_DIR=D:/metafinder-jobs

# Node.js executable for JavaScript game modules. Default: `node` on PATH.
# METAFINDER_NODE=C:/Program Files/nodejs/node.exe
